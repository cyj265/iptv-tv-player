<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- ===== 全屏视频画面 ===== -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        android:useController="false"
        app:resize_mode="fit" />

    <!-- ===== 顶部：当前频道信息（覆盖层） ===== -->
    <LinearLayout
        android:id="@+id/nowPlayingBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:background="@color/bg_overlay"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvChannelName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/no_channels" />

        <TextView
            android:id="@+id/tvEpgNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="@string/no_epg" />
    </LinearLayout>

    <!-- ===== 底部：精简控制条（覆盖层，直播语义） ===== -->
    <LinearLayout
        android:id="@+id/controlBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg_overlay"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnList"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="@string/channel_list"
            android:background="@drawable/bg_control"
            android:src="@drawable/ic_list"
            android:scaleType="centerInside" />

        <ImageButton
            android:id="@+id/btnPrev"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="@string/prev_channel"
            android:background="@drawable/bg_control"
            android:src="@drawable/ic_prev"
            android:scaleType="centerInside"
            android:layout_marginLeft="16dp" />

        <ImageButton
            android:id="@+id/btnPlayPause"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:contentDescription="@string/play_pause"
            android:background="@drawable/bg_control_accent"
            android:src="@drawable/ic_pause"
            android:scaleType="centerInside"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp" />

        <ImageButton
            android:id="@+id/btnNext"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="@string/next_channel"
            android:background="@drawable/bg_control"
            android:src="@drawable/ic_next"
            android:scaleType="centerInside" />

        <ImageButton
            android:id="@+id/btnFavoriteCurrent"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="@string/favorite_hint"
            android:background="@drawable/bg_control"
            android:src="@drawable/ic_star"
            android:scaleType="centerInside"
            android:layout_marginLeft="16dp" />
    </LinearLayout>

    <!-- ===== 左侧：频道列表悬浮层（OK 唤出，默认隐藏） ===== -->
    <LinearLayout
        android:id="@+id/channelPanel"
        android:layout_width="420dp"
        android:layout_height="match_parent"
        android:layout_gravity="left"
        android:orientation="vertical"
        android:background="@color/bg_overlay_strong"
        android:visibility="gone">

        <!-- 工具条：搜索 + 收藏 + 设置 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:hint="@string/search_hint"
                android:singleLine="true"
                android:background="@drawable/bg_search"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="15sp"
                android:imeOptions="actionSearch"
                android:inputType="text" />

            <ImageButton
                android:id="@+id/btnFavorites"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/favorites"
                android:background="?attr/selectableItemBackground"
                android:src="@drawable/ic_star"
                android:scaleType="centerInside"
                android:layout_marginLeft="8dp" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/settings"
                android:background="?attr/selectableItemBackground"
                android:src="@drawable/ic_settings"
                android:scaleType="centerInside"
                android:layout_marginLeft="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="8dp"
            android:text="@string/channel_list"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/channelList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />
    </LinearLayout>

    <!-- ===== 右侧：设置悬浮层（菜单键唤出，默认隐藏） ===== -->
    <ScrollView
        android:id="@+id/settingsPanel"
        android:layout_width="430dp"
        android:layout_height="match_parent"
        android:layout_gravity="right"
        android:background="@color/bg_overlay_strong"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="24dp">

            <!-- 标题 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:paddingBottom="16dp" />

            <!-- ===== 分区：播放列表 ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/playlist_url"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/inputPlaylistUrl"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_search"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="15sp"
                android:inputType="textUri"
                android:hint="https://example.com/list.m3u 或 list.txt" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnImportFile"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="@string/choose_file"
                    android:textSize="14sp"
                    android:backgroundTint="@color/bg_item"
                    android:textColor="@color/text_primary" />

                <Button
                    android:id="@+id/btnLoadPlaylist"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="10dp"
                    android:text="@string/load"
                    android:textSize="14sp"
                    android:backgroundTint="@color/accent"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <!-- ===== 分区：节目指南 ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/epg_url"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/inputEpgUrl"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_search"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="15sp"
                android:inputType="textUri"
                android:hint="https://example.com/epg.xml（可选）" />

            <!-- ===== 分区：直播流链接 ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/direct_stream"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/inputDirectUrl"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_search"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="15sp"
                android:inputType="textUri"
                android:hint="http://example.com/live.m3u8" />

            <Button
                android:id="@+id/btnPlayDirect"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:text="@string/play_direct"
                android:textSize="14sp"
                android:backgroundTint="@color/accent"
                android:textColor="#FFFFFF" />

            <!-- ===== 分区：播放选项 ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/playback_options"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/aspect_ratio"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnAspectRatio"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:text="@string/aspect_fit"
                android:textSize="14sp"
                android:backgroundTint="@color/bg_item"
                android:textColor="@color/text_primary" />

            <CheckBox
                android:id="@+id/chkAutoResume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/auto_resume"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:focusable="true"
                android:clickable="true"
                android:padding="6dp" />

            <!-- ===== 分区：收藏 ===== -->
            <Button
                android:id="@+id/btnClearFavorites"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="22dp"
                android:text="@string/clear_favorites"
                android:textSize="14sp"
                android:backgroundTint="@color/bg_item"
                android:textColor="@color/text_primary" />

            <!-- ===== 分区：关于 ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/about"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />

            <Button
                android:id="@+id/btnCloseSettings"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="22dp"
                android:text="@string/close"
                android:textSize="15sp"
                android:backgroundTint="@color/accent"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
